<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center">

        <!-- Card container -->
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp">

            <!-- Service Image - Smaller -->
            <ImageView
                android:id="@+id/serviceImage"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/service_maid"
                android:contentDescription="Service Image"/>

            <!-- Content Section -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Title -->
                <TextView
                    android:id="@+id/title"
                    android:text="New Booking"
                    android:textColor="#1E293B"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Service Type -->
                <TextView
                    android:id="@+id/subtitle"
                    android:text="MAID"
                    android:textColor="#3B82F6"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Countdown Timer - Now visible and highlighted -->
                <TextView
                    android:id="@+id/countdown"
                    android:text="30s"
                    android:textColor="#DC2626"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="#FEE2E2"
                    android:padding="10dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="visible"/>

                <!-- Price Section - Smaller -->
                <LinearLayout
                    android:orientation="vertical"
                    android:background="#D1FAE5"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/price"
                        android:text="₹200"
                        android:textColor="#059669"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Community Section - Hidden -->
                <TextView
                    android:id="@+id/community"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Hidden fields for data -->
                <TextView
                    android:id="@+id/customerName"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:id="@+id/flatNo"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Action Buttons -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnReject"
                        android:text="REJECT"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#EF4444"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:paddingVertical="16dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnAccept"
                        android:text="ACCEPT"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#10B981"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="16dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
