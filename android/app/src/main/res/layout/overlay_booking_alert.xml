<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center">

        <!-- Card container -->
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp">

            <!-- Service Image -->
            <ImageView
                android:id="@+id/serviceImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/service_maid"
                android:contentDescription="Service Image"/>

            <!-- Content Section -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Header with Title and Timer -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/title"
                        android:text="New Booking"
                        android:textColor="#1E293B"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <!-- Countdown Timer with Circle -->
                    <RelativeLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <ProgressBar
                            android:id="@+id/countdownCircle"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="30"
                            android:progress="30"
                            android:progressDrawable="@drawable/circular_progress"
                            android:indeterminate="false"/>

                        <TextView
                            android:id="@+id/countdown"
                            android:text="30s"
                            android:textColor="#22C55E"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_centerInParent="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                </LinearLayout>

                <!-- Service Type -->
                <TextView
                    android:id="@+id/subtitle"
                    android:text="MAID"
                    android:textColor="#3B82F6"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Price Section -->
                <LinearLayout
                    android:orientation="vertical"
                    android:background="#D1FAE5"
                    android:padding="24dp"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/price"
                        android:text="₹200"
                        android:textColor="#10B981"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Tower Number Section -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#F1F5F9"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="🏢 Tower: "
                        android:textColor="#64748B"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/towerNo"
                        android:text="1"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Community Section -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#F1F5F9"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="📍"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/community"
                        android:text="prestige-high-fields"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Hidden fields for data -->
                <TextView
                    android:id="@+id/customerName"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:id="@+id/flatNo"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Action Buttons -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnReject"
                        android:text="REJECT"
                        android:textColor="#EF4444"
                        android:background="@drawable/btn_outline"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:paddingVertical="16dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnAccept"
                        android:text="ACCEPT"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#10B981"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="16dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
