<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:padding="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:elevation="4dp"
        app:cardCornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header Section -->
            <RelativeLayout
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/alertTitle"
                    android:text="New Booking Request"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:fontFamily="sans-serif-medium"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RelativeLayout
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ProgressBar
                        android:id="@+id/countdownCircle"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:max="30"
                        android:progress="30"
                        android:progressDrawable="@drawable/circular_progress"
                        android:indeterminate="false" />

                    <TextView
                        android:id="@+id/countdown"
                        android:text="28s"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#22C55E"
                        android:gravity="center"
                        android:layout_centerInParent="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </RelativeLayout>
            </RelativeLayout>

            <View
                android:background="#E5E7EB"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <!-- Service Image -->
            <ImageView
                android:id="@+id/alertServiceImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/maid_dishes"
                android:contentDescription="Service Image" />

            <!-- Service Title -->
            <TextView
                android:id="@+id/alertService"
                android:text="Maid Service"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Service Subtitle -->
            <TextView
                android:id="@+id/alertServiceSubtitle"
                android:text="Includes: Dishes &amp; Jhaadu/Pocha"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Price and Tower Cards -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Price Card -->
                <androidx.cardview.widget.CardView
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F4F6"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Price"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginBottom="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/alertPrice"
                            android:text="₹200"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tower Card -->
                <androidx.cardview.widget.CardView
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F4F6">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Tower No."
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginBottom="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/alertTower"
                            android:text="9"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Community Card -->
            <androidx.cardview.widget.CardView
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F3F4F6">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Community"
                        android:textSize="13sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/alertCommunity"
                        android:text="prestige-high-fields"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnReject"
                    android:text="REJECT"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_outline"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:paddingVertical="18dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnAccept"
                    android:text="ACCEPT"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#22C55E"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:paddingVertical="18dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
