<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header with Title and Countdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/alertTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New Booking Request"
                        android:textColor="#1E293B"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <!-- Countdown Ring Container -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <ProgressBar
                            android:id="@+id/countdownCircle"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:indeterminate="false"
                            android:max="30"
                            android:progress="30"
                            android:progressDrawable="@drawable/circular_progress"
                            android:rotation="-90"/>

                        <TextView
                            android:id="@+id/countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="30s"
                            android:textColor="#DC2626"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"/>

                <!-- Body Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Hero Image -->
                    <ImageView
                        android:id="@+id/alertHeroImage"
                        android:layout_width="match_parent"
                        android:layout_height="176dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/rounded_image_bg"
                        android:contentDescription="Service Image"/>

                    <!-- Service Title -->
                    <TextView
                        android:id="@+id/alertService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Maid Service"
                        android:textColor="#1E293B"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <!-- Service Subtitle -->
                    <TextView
                        android:id="@+id/alertServiceSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Includes: Dishes &amp; Jhaadu/Pocha"
                        android:textColor="#64748B"
                        android:textSize="14sp"/>

                    <!-- Info Grid (2 cards) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Price Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/info_card_bg"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/alertPriceLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price"
                                android:textColor="#64748B"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/alertPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="₹150"
                                android:textColor="#1E293B"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Tower Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/info_card_bg"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/alertTowerLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tower No."
                                android:textColor="#64748B"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/alertTower"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="9"
                                android:textColor="#1E293B"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Community Card (full width) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/info_card_bg"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/alertCommunityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Community"
                            android:textColor="#64748B"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/alertCommunity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Prestige High Fields"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Optional Notes Block -->
                    <LinearLayout
                        android:id="@+id/alertNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/info_card_bg"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textColor="#64748B"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/alertNotesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#1E293B"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Footer with Buttons -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnReject"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="REJECT"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#475569"
                            android:background="@drawable/btn_outline"
                            style="?android:attr/borderlessButtonStyle"/>

                        <Button
                            android:id="@+id/btnAccept"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="ACCEPT"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#16A34A"/>
                    </LinearLayout>

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
