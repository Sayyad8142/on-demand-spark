<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#CC000000"
    android:gravity="center"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/alertTitle"
        android:text="New Booking Request!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/alertCustomer"
            android:text="Customer: Loading..."
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertCommunity"
            android:text="Community: Loading..."
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertService"
            android:text="Service: Loading..."
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertPrice"
            android:text="₹0"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#22C55E"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/countdown"
        android:text="30s"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnReject"
            android:text="Reject"
            android:textSize="18sp"
            android:backgroundTint="#EF4444"
            android:layout_margin="8dp"
            android:minWidth="140dp"
            android:minHeight="56dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnAccept"
            android:text="Accept"
            android:textSize="18sp"
            android:backgroundTint="#10B981"
            android:layout_margin="8dp"
            android:minWidth="140dp"
            android:minHeight="56dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/authStatus"
        android:text="✅ Authenticated"
        android:textColor="#22C55E"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:background="#F0FDF4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
