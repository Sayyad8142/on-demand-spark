<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Section -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="New Booking Request"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Respond within 30 seconds"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#22C55E"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/countdown"
                android:text="30s"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/countdownCircle"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="30"
                android:progress="30"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#FFFFFF66" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:background="#E5E5E5"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <!-- Service Image -->
    <ImageView
        android:id="@+id/alertServiceImage"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        android:src="@drawable/maid_dishes"
        android:contentDescription="Service Image" />

    <!-- Service Title -->
    <TextView
        android:id="@+id/alertService"
        android:text="Maid Service"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Service Subtitle -->
    <TextView
        android:id="@+id/alertServiceSubtitle"
        android:text="Includes: Dishes &amp; Jhaadu/Pocha"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Price and Tower Cards -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Price Card -->
        <LinearLayout
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="20dp"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Price"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/alertPrice"
                android:text="₹0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Tower Card -->
        <LinearLayout
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="20dp"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Tower No."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/alertTower"
                android:text="—"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Community Card -->
    <LinearLayout
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Community"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertCommunity"
            android:text="Prestige High Fields"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_margin="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnReject"
            android:text="Reject"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:background="@drawable/btn_outline"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:paddingVertical="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnAccept"
            android:text="Accept"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22C55E"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:paddingVertical="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</LinearLayout>
